generator client {
  provider = "prisma-client-js"  
}

datasource db {
  provider = "mysql"
}

model Usuarios {
  cpf          String @id @db.VarChar(11)
  nomeUsuario  String @db.VarChar(100)
  emailUsuario String @unique @db.VarChar(250)
  senhaUsuario String @db.VarChar(100)

  produtos     Produtos[]
}

model Produtos {
  idProdutos       Int     @id @default(autoincrement())
  tipoProduto      String  @db.VarChar(300)
  descricaoProduto String  @db.VarChar(500)
  precoProduto     Decimal @db.Decimal(10, 2)

  usuarioCpf        String  
  administradorCpf  String
  administrador     Administrador @relation(fields: [administradorCpf], references: [cpf])
  usuario           Usuarios @relation(fields: [usuarioCpf], references: [cpf])
}
